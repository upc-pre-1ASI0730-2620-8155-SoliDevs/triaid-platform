<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.2.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- Asp.Net Core related packages -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.18.0"/>
        <!-- Entity Framework Core related packages -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" >
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13"/>
        <!-- MySQL Entity Framework Core related packages -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0"/>
        <!-- Naming convention conversion related packages -->
        <PackageReference Include="Humanizer" Version="3.0.10"/>
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.0"/>
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Alerting\Application\Errors\" />
      <Folder Include="Devices\Application\Internal\" />
      <Folder Include="Devices\Domain\Model\Commands\" />
      <Folder Include="Devices\Domain\Model\Events\" />
      <Folder Include="Devices\Domain\Services\" />
    </ItemGroup>

</Project>
